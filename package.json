{
  "name": "speaker-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "sh -c 'concurrently -k \"npm run dev:server -- $*\" \"npm:dev:web\"' --",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@picovoice/pvrecorder-node": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^16.4.5",
    "lucide-react": "^1.54.0",
    "p5": "^1.11.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "sirv": "^3.0.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.12.0",
    "@types/p5": "^1.7.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
