INGEST=mock            # mock | assemblyai
ASSEMBLYAI_API_KEY=
SPEECH_MODEL=universal-3-6-pro
MAX_SPEAKERS=          # optional 1..10; override at launch with `npm run dev -- --speakers=3`
AUDIO_DEVICE_INDEX=    # pin a mic by index; empty = auto-select. The server prints the device list on start.
AUDIO_DEVICE_MATCH=    # name substring that wins auto-select (default "usb"); else the system default input is used
COMMIT_DEBOUNCE_MS=900  # silence (ms) before a run commits; lower = snappier, higher = fewer split lines
PORT=8787
DEBUG_LOG_FILE=         # path (e.g. logs/run1.jsonl) to capture raw AssemblyAI + segmenter JSONL; empty = off

# Board: an agent keeps a tile board (people, facts, positions, timelines) about the conversation.
BOARD=off               # agent | mock | off; override at launch with `npm run dev -- --board=mock`
OPENROUTER_API_KEY=     # required for BOARD=agent
EXA_API_KEY=            # optional: web search via Exa (results checked by the server); empty = OpenRouter's built-in search
BOARD_MODEL=anthropic/claude-sonnet-5.5   # frequent small updates; any OpenRouter model with tool calling
BOARD_EFFORT=medium     # low | medium | high | xhigh | max (reasoning effort per update)
BOARD_INTERVAL_S=30     # minimum seconds between board runs; each run is one paid model call chain
BOARD_EDITOR_MODEL=anthropic/claude-opus-5.5   # periodic pass that reorganizes the whole board
BOARD_EDITOR_EFFORT=high
BOARD_EDITOR_INTERVAL_S=180   # seconds between editor passes, only while the board is changing
OPENROUTER_BASE_URL=    # optional, e.g. a regional OpenRouter endpoint; empty = https://openrouter.ai/api/v1

# Installation launch (kiosk), after `npm run build`:
#   INGEST=assemblyai ASSEMBLYAI_API_KEY=<key> npm run start
#   open -a "Brave Browser" --args --kiosk --autoplay-policy=no-user-gesture-required http://localhost:8787
#   (append ?view=board to the URL to open the board instead of the transcript)
